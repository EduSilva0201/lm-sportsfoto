{
  "name": "lm-sportsfoto",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node backend/server.mjs",
    "admin:setup": "node backend/setup.mjs",
    "test": "node --test backend/test/*.test.mjs",
    "format": "prettier --write \"dist/*.{html,css,js}\" \"backend/**/*.{html,css,js,mjs,json}\" \"cloudflare/**/*.mjs\" \"tests/*.mjs\" \"*.{json,jsonc}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"dist/*.{html,css,js}\" \"backend/**/*.{html,css,js,mjs,json}\" \"cloudflare/**/*.mjs\" \"tests/*.mjs\" \"*.{json,jsonc}\" \".vscode/*.json\"",
    "cloudflare:build": "node cloudflare/build.mjs",
    "cloudflare:check": "npm run cloudflare:build && wrangler deploy --dry-run --outdir .cloudflare-worker-check",
    "cloudflare:dev": "npm run cloudflare:build && wrangler dev --var PUBLIC_ORIGIN:http://localhost:8787",
    "cloudflare:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:mobile": "node tests/mobile.mjs",
    "cloudflare:export": "node cloudflare/export-local.mjs",
    "backup:local": "node backend/backup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "jose": "6.2.14"
  }
}
