{
  "name": "lm-sportsfoto",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".cloudflare-build",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lm-sportsfoto",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "lm-sportsfoto-capas",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://seu-dominio.example",
    "ACCESS_TEAM_DOMAIN": "https://sua-equipe.cloudflareaccess.com",
    "ACCESS_AUD": "CONFIGURAR_AUDIENCIA_DO_ACCESS",
    "ADMIN_EMAILS": "CONFIGURAR_EMAIL_AUTORIZADO",
  },
}
